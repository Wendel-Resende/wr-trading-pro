  // Se é um fechamento (entry === 1), remover a posição correspondente
  if (trade.entry === 1 && trade.position) {
    console.log('Fechamento de posição (trade):', trade.position);
    setPositions(prev => prev.filter(p => p.ticket !== trade.position));
