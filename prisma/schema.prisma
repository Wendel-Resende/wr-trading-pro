// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Asset {
  id          String   @id @default(cuid())
  symbol      String   @unique
  name        String
  type        String   // STOCK, ETF, CRYPTO, FOREX
  exchange    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  positions          Position[]
  orders             Order[]
  predictions        Prediction[]
  marketData         MarketData[]
  stockMonitoring    StockMonitoring[]
}

model Position {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id])
  quantity      Int
  avgPrice      Float
  currentPrice  Float
  pnl           Float    @default(0)
  status        String   // OPEN, CLOSED
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  
  @@index([assetId])
}

model Order {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  type        String   // BUY, SELL
  orderType   String   // MARKET, LIMIT, STOP
  quantity    Int
  price       Float?
  status      String   // PENDING, FILLED, CANCELLED, REJECTED
  createdAt   DateTime @default(now())
  filledAt    DateTime?
  
  @@index([assetId])
}

model Prediction {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id])
  modelType     String   // LSTM, GRU, TRANSFORMER, ENSEMBLE
  prediction    String   // BUY, HOLD, SELL
  confidence    Float
  targetPrice   Float?
  timeframe     String   // 1M, 5M, 15M, 1H, 1D
  createdAt     DateTime @default(now())
  
  @@index([assetId])
}

model MarketData {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  timestamp   DateTime
  open        Float
  high        Float
  low         Float
  close       Float
  volume      BigInt
  
  @@unique([assetId, timestamp])
  @@index([assetId])
  @@index([timestamp])
}

model TechnicalIndicator {
  id          String   @id @default(cuid())
  assetId     String
  indicator   String   // RSI, MACD, BOLLINGER, SMA, EMA
  value       Float
  signal      String   // BUY, SELL, NEUTRAL
  timestamp   DateTime @default(now())
  
  @@index([assetId])
}

model Alert {
  id          String   @id @default(cuid())
  type        String   // PRICE, VOLUME, INDICATOR, RISK
  message     String
  severity    String   // INFO, WARNING, CRITICAL
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AIProvider {
  id          String   @id @default(cuid())
  name        String   @unique // OPENAI, DEEPSEEK, OLLAMA, QWEN, GROQ
  apiKey      String?
  endpoint    String?
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DataSource {
  id          String   @id @default(cuid())
  name        String   @unique // MOCK, B3, PROFITDLL, MT5
  type        String
  config      String   // JSON string with credentials/settings
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemMetrics {
  id          String   @id @default(cuid())
  metricName  String
  value       Float
  timestamp   DateTime @default(now())
  
  @@index([metricName])
  @@index([timestamp])
}

model SpreadOrder {
  id              String   @id @default(cuid())
  assetId1        String
  assetId2        String
  type1           String   // BUY, SELL
  type2           String   // BUY, SELL
  quantity1       Int
  quantity2       Int
  price1          Float
  price2          Float
  spreadValue     Float
  status          String   // PENDING, FILLED, CANCELLED, REJECTED
  isAutomated     Boolean  @default(false)
  automationTarget Float?
  automationCondition String? // greater_than, less_than, equal_to
  createdAt       DateTime @default(now())
  filledAt        DateTime?
  mt5OrderTicket1 Int?
  mt5OrderTicket2 Int?
  
  @@index([assetId1])
  @@index([assetId2])
  @@index([status])
  @@index([createdAt])
}

// Modelo para monitoramento de ações B3 (apenas monitoramento, sem envio de ordens)
model StockMonitoring {
  id                          String   @id @default(cuid())
  assetId                     String
  asset                       Asset    @relation(fields: [assetId], references: [id])
  
  // Dados fundamentais
  stockType                   String   // ON, PN
  composition                 Float    @default(1)
  payoutEstatuto              Float?
  dyMedia3Anos                Float?
  
  // Gatilhos de compra (indicadores para decisão)
  gatilhoROE                  Float?
  gatilhoVPA                  Float?
  gatilhoLPA                  Float?
  
  // Preços de referência (cálculos da plataforma)
  precoTeto                   Float?
  precoTetoReajustado         Float?
  
  // Metas de posição
  metaPapeis                  Int      @default(0)
  investimentoNecessarioParaMeta Float?
  
  // Dados financeiros da empresa (entrada manual)
  patrimonioLiquido           Float?
  lucroLiquido                Float?
  acoesEmitidas               BigInt?
  vpa                         Float?
  pVpa                        Float?
  lpa                         Float?
  precoLucro                  Float?
  roe                         Float?
  
  // Projeção de dividendos
  previsaoDividendoAnual      Float?
  yieldOnCost                 Float?
  
  // Dados de posição (vêm do MT5)
  precoAtual                  Float?
  quantidadeAdquirida         Int      @default(0)
  precoMedioCompra            Float?
  valorInvestido              Float?
  valorCarteira               Float?
  resultado                   Float    @default(0)
  participacaoCarteira        Float?
  
  // Status do monitoramento
  status                      String   @default("NEUTRO") // COMPRA, VENDA, NEUTRO, ATENCAO
  observacoes                 String?
  
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  
  dividendMaps                DividendMap[]
  alerts                      StockAlert[]
  
  @@index([assetId])
  @@index([status])
}

// Mapa mensal de dividendos por ação
model DividendMap {
  id          String   @id @default(cuid())
  stockId     String
  jan         Float    @default(0)
  fev         Float    @default(0)
  mar         Float    @default(0)
  abr         Float    @default(0)
  mai         Float    @default(0)
  jun         Float    @default(0)
  jul         Float    @default(0)
  ago         Float    @default(0)
  set         Float    @default(0)
  out         Float    @default(0)
  nov         Float    @default(0)
  dez         Float    @default(0)
  total       Float    @default(0)
  ano         Int
  
  stock       StockMonitoring @relation(fields: [stockId], references: [id])
  
  @@unique([stockId, ano])
  @@index([stockId])
}

// Alertas específicos para monitoramento de ações
model StockAlert {
  id          String   @id @default(cuid())
  stockId     String
  stock       StockMonitoring @relation(fields: [stockId], references: [id])
  
  type        String   // PRICE, DIVIDEND, STATUS, PORTFOLIO
  condition   String   // above, below, equals, changed_to
  value       Float?
  targetValue Float?
  message     String
  severity    String   // INFO, WARNING, CRITICAL
  isActive    Boolean  @default(true)
  isRead      Boolean  @default(false)
  triggeredAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([stockId])
  @@index([isActive])
  @@index([isRead])
  @@index([type])
}

// Relatórios de monitoramento de ações
model StockReport {
  id          String   @id @default(cuid())
  name        String
  type        String   // PORTFOLIO, PERFORMANCE, DIVIDENDS, STATUS

  startDate   DateTime
  endDate     DateTime

  // Dados do relatório (JSON)
  data        String   // JSON com dados do relatório

  generatedBy String   // Sistema ou usuário

  createdAt   DateTime @default(now())

  @@index([type])
  @@index([startDate])
  @@index([endDate])
}

// Cache de candles históricos do MT5 para o pipeline de ML
model HistoricalCandle {
  id        Int      @id @default(autoincrement())
  symbol    String
  timeframe String
  time      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, time])
  @@index([symbol, timeframe, time])
}

// ---------------------------------------------------------------------------
// Fase 2 / Item 1 — Fundação de dados de referência (Issuer + Instrument +
// IngestionRun). Modelos ADITIVOS: nenhum modelo existente foi alterado.
// Invariantes de ciclo de vida/intervalo são garantidos no repositório
// (unit of work), não por triggers SQL. Ver
// docs/architecture/phase-2-item-1-reference-data.md
// ---------------------------------------------------------------------------

// Ledger de execuções de ingestão de dados de referência.
// sourceKey é uma String imutável normalizada (sem relação com DataSource legado).
// completedAt de uma run SUCCEEDED é o knowledgeTime das linhas criadas por ela.
model IngestionRun {
  id          String    @id @default(cuid())
  sourceKey   String
  status      String // RUNNING, SUCCEEDED, FAILED
  startedAt   DateTime
  completedAt DateTime?
  summary     String? // JSON com resumo do lote

  issuers                   Issuer[]
  createdInstrumentVersions InstrumentVersion[] @relation("InstrumentVersionCreatedByRun")
  closedInstrumentVersions  InstrumentVersion[] @relation("InstrumentVersionClosedByRun")
  cvmFilings                CvmFiling[]
  cvmFacts                  CvmFact[]
  shareCapitalFacts         ShareCapitalFact[]
  versionedMarketBars       VersionedMarketBar[]

  @@index([sourceKey, startedAt])
  @@index([status])
}

// Identidade estável e imutável de emissor, chaveada por cvmCode normalizado.
// Registro conflitante com identidade existente falha fechado (sem SCD-1 destrutivo).
// cnpj é opcional (múltiplos NULL aceitos) e único quando presente — 14 dígitos.
model Issuer {
  id             String  @id @default(cuid())
  cvmCode        String  @unique
  cnpj           String? @unique
  name           String
  createdByRunId String

  createdByRun       IngestionRun        @relation(fields: [createdByRunId], references: [id])
  instrumentVersions InstrumentVersion[]
  cvmFilings         CvmFiling[]
  cvmFacts           CvmFact[]
  shareCapitalFacts  ShareCapitalFact[]

  @@index([createdByRunId])
}

// Versão SCD-2 de instrumento com intervalo semiaberto [validFrom, validTo).
// validTo NULL = intervalo aberto (no máximo um por (symbol, exchange)).
// priceScalePow/quantityScalePow são EXPOENTES decimais: quantum = 10^scalePow
// (scalePow pode ser negativo). validFromBasis: SOURCE_EFFECTIVE | OBSERVED_AT.
model InstrumentVersion {
  id               String    @id @default(cuid())
  symbol           String
  exchange         String
  currency         String
  displayName      String
  assetClass       String
  status           String // ACTIVE, SUSPENDED, DELISTED
  priceScalePow    Int?
  quantityScalePow Int?
  lotSize          Int?
  validFrom        DateTime
  validTo          DateTime?
  validFromBasis   String // SOURCE_EFFECTIVE, OBSERVED_AT
  issuerId         String?
  createdByRunId   String
  closedByRunId    String?

  issuer       Issuer?       @relation(fields: [issuerId], references: [id])
  createdByRun IngestionRun  @relation("InstrumentVersionCreatedByRun", fields: [createdByRunId], references: [id])
  closedByRun  IngestionRun? @relation("InstrumentVersionClosedByRun", fields: [closedByRunId], references: [id])

  versionedMarketBars VersionedMarketBar[]

  @@unique([symbol, exchange, validFrom])
  @@index([symbol, exchange, validTo])
  @@index([issuerId])
  @@index([createdByRunId])
  @@index([closedByRunId])
}

// ---------------------------------------------------------------------------
// Fase 2 / Item 2 — CVM Filings e Fatos Point-in-Time (CvmFiling + CvmFact +
// ShareCapitalFact). Modelos ADITIVOS: nenhum modelo existente foi alterado.
// Append-only: nenhuma linha é jamais UPDATE/DELETE destrutivo. Invariantes
// de idempotência/cadeia de retificação/point-in-time são garantidos na
// PrismaCvmIngestionUnitOfWork (não por triggers SQL). Ver
// docs/architecture/phase-2-item-2-cvm-facts.md
// ---------------------------------------------------------------------------

// Documento regulatório CVM (DFP/ITR/FRE) de um Issuer já existente (o batch
// CVM nunca cria Issuer). publishedAt é o eixo de disponibilidade de mercado;
// o knowledgeTime da plataforma é sempre derivado via join com createdByRun
// (completedAt), nunca persistido aqui. cvmProtocol é globalmente único.
// versionNumber/isRestatement/supersedesFilingId formam a cadeia de
// retificação; nenhuma linha anterior é jamais atualizada ou apagada.
model CvmFiling {
  id                  String    @id @default(cuid())
  issuerId            String
  documentType        String // DFP, ITR, FRE
  cvmProtocol         String    @unique
  referenceDate       String // YYYY-MM-DD
  fiscalYear          Int
  fiscalQuarter       Int?
  filedAt             DateTime
  publishedAt         DateTime
  versionNumber       Int
  isRestatement       Boolean
  supersedesFilingId  String?   @unique
  sourceUrl           String
  rawSha256           String // 64 lowercase hex chars
  createdByRunId      String

  issuer            Issuer         @relation(fields: [issuerId], references: [id])
  createdByRun      IngestionRun   @relation(fields: [createdByRunId], references: [id])
  supersedesFiling  CvmFiling?     @relation("CvmFilingChain", fields: [supersedesFilingId], references: [id])
  supersededByFilings CvmFiling[]  @relation("CvmFilingChain")

  facts             CvmFact[]
  shareCapitalFacts ShareCapitalFact[]

  @@unique([issuerId, documentType, referenceDate, versionNumber])
  @@index([createdByRunId])
  @@index([publishedAt])
}

// Fato contábil exato extraído de um CvmFiling. valor real = valueRaw *
// 10^scalePow. INSTANT exige periodStart === periodEnd; DURATION exige
// periodStart <= periodEnd. Unicidade dentro do filing garantida em
// runtime (não pode ser um @@unique físico por causa de NULL em SQLite
// não seria o problema aqui — todos os campos são NOT NULL — o índice
// único abaixo garante a unicidade normativa).
model CvmFact {
  id             String   @id @default(cuid())
  filingId       String
  issuerId       String
  statementType  String // BPA, BPP, DRE, DFC_MD, DFC_MI, DVA, DMPL
  scope          String // CON, IND
  accountCode    String
  accountLabel   String
  periodStart    String // YYYY-MM-DD
  periodEnd      String // YYYY-MM-DD
  durationType   String // INSTANT, DURATION
  valueRaw       BigInt
  scalePow       Int
  originalScale  String
  currency       String
  quality        String
  createdByRunId String

  filing       CvmFiling    @relation(fields: [filingId], references: [id])
  issuer       Issuer       @relation(fields: [issuerId], references: [id])
  createdByRun IngestionRun @relation(fields: [createdByRunId], references: [id])

  @@unique([filingId, statementType, scope, accountCode, periodStart, periodEnd])
  @@index([issuerId, statementType, scope, accountCode, periodEnd])
  @@index([filingId])
  @@index([createdByRunId])
}

// Composição de capital social extraída de um CvmFiling. periodStart ===
// periodEnd sempre (conceito INSTANT). quantity é não-negativa, signed 64-bit.
model ShareCapitalFact {
  id             String   @id @default(cuid())
  filingId       String
  issuerId       String
  shareClass     String
  periodStart    String // YYYY-MM-DD
  periodEnd      String // YYYY-MM-DD
  quantity       BigInt
  quantityType   String // ISSUED, OUTSTANDING, TREASURY
  quality        String
  createdByRunId String

  filing       CvmFiling    @relation(fields: [filingId], references: [id])
  issuer       Issuer       @relation(fields: [issuerId], references: [id])
  createdByRun IngestionRun @relation(fields: [createdByRunId], references: [id])

  @@unique([filingId, shareClass, periodEnd, quantityType])
  @@index([issuerId, shareClass, quantityType, periodEnd])
  @@index([filingId])
  @@index([createdByRunId])
}

// ---------------------------------------------------------------------------
// Fase 2 / Item 3 — Fundação de MarketBar versionada e point-in-time
// (VersionedMarketBar). Modelo ADITIVO: nenhum modelo legado (MarketData,
// HistoricalCandle) foi alterado. Apenas relações aditivas foram adicionadas
// a IngestionRun e InstrumentVersion (sem colunas novas nessas tabelas).
// Append-only: nenhuma linha é jamais UPDATE/DELETE destrutivo. Invariantes
// de idempotência/cadeia de revisão/point-in-time são garantidas na
// PrismaMarketBarIngestionUnitOfWork (não por triggers SQL). Ver
// docs/architecture/phase-2-item-3-market-bar.md
// ---------------------------------------------------------------------------

// Barra de mercado (OHLCV) versionada por fonte/revisão, exata (sem float) e
// point-in-time. Valor real de preço = rawValue * 10^priceScalePow; valor
// real de volume = volumeRaw * 10^volumeScalePow. sourceKey é derivado da
// IngestionRun corrente (nunca enviado na submission). Cadeia de revisão:
// root tem revisionNumber=1 e supersedesBarId=null; cada revisão aponta
// para o predecessor via supersedesBarId (único) e revisionNumber =
// predecessor.revisionNumber + 1.
model VersionedMarketBar {
  id                  String   @id @default(cuid())
  instrumentVersionId String
  sourceKey           String
  sourceRecordKey     String
  timeframe           String
  openedAt            DateTime
  closedAt            DateTime
  sourceAvailableAt   DateTime
  openRaw             BigInt
  highRaw             BigInt
  lowRaw              BigInt
  closeRaw            BigInt
  priceScalePow       Int
  volumeRaw           BigInt
  volumeScalePow      Int
  volumeSemantics     String // TICKS, CONTRACTS, SHARES, NOTIONAL
  tradeCount          BigInt?
  priceBasis          String // TRADE, MID, BID, ASK
  quality             String // FINAL, PROVISIONAL, ESTIMATED, CORRECTED
  rawSha256           String // 64 lowercase hex chars
  revisionNumber      Int
  supersedesBarId     String?  @unique
  createdByRunId      String

  instrumentVersion InstrumentVersion    @relation(fields: [instrumentVersionId], references: [id])
  createdByRun      IngestionRun         @relation(fields: [createdByRunId], references: [id])
  supersedesBar     VersionedMarketBar?  @relation("MarketBarRevisionChain", fields: [supersedesBarId], references: [id])
  supersededByBars  VersionedMarketBar[] @relation("MarketBarRevisionChain")

  @@unique([instrumentVersionId, timeframe, sourceKey, openedAt, revisionNumber])
  @@unique([sourceKey, sourceRecordKey])
  @@index([instrumentVersionId, timeframe, sourceKey, openedAt])
  @@index([createdByRunId])
  @@index([sourceAvailableAt])
}
