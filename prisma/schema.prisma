// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Asset {
  id          String   @id @default(cuid())
  symbol      String   @unique
  name        String
  type        String   // STOCK, ETF, CRYPTO, FOREX
  exchange    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  positions          Position[]
  orders             Order[]
  predictions        Prediction[]
  marketData         MarketData[]
  stockMonitoring    StockMonitoring[]
}

model Position {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id])
  quantity      Int
  avgPrice      Float
  currentPrice  Float
  pnl           Float    @default(0)
  status        String   // OPEN, CLOSED
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  
  @@index([assetId])
}

model Order {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  type        String   // BUY, SELL
  orderType   String   // MARKET, LIMIT, STOP
  quantity    Int
  price       Float?
  status      String   // PENDING, FILLED, CANCELLED, REJECTED
  createdAt   DateTime @default(now())
  filledAt    DateTime?
  
  @@index([assetId])
}

model Prediction {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id])
  modelType     String   // LSTM, GRU, TRANSFORMER, ENSEMBLE
  prediction    String   // BUY, HOLD, SELL
  confidence    Float
  targetPrice   Float?
  timeframe     String   // 1M, 5M, 15M, 1H, 1D
  createdAt     DateTime @default(now())
  
  @@index([assetId])
}

model MarketData {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  timestamp   DateTime
  open        Float
  high        Float
  low         Float
  close       Float
  volume      BigInt
  
  @@unique([assetId, timestamp])
  @@index([assetId])
  @@index([timestamp])
}

model TechnicalIndicator {
  id          String   @id @default(cuid())
  assetId     String
  indicator   String   // RSI, MACD, BOLLINGER, SMA, EMA
  value       Float
  signal      String   // BUY, SELL, NEUTRAL
  timestamp   DateTime @default(now())
  
  @@index([assetId])
}

model Alert {
  id          String   @id @default(cuid())
  type        String   // PRICE, VOLUME, INDICATOR, RISK
  message     String
  severity    String   // INFO, WARNING, CRITICAL
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AIProvider {
  id          String   @id @default(cuid())
  name        String   @unique // OPENAI, DEEPSEEK, OLLAMA, QWEN, GROQ
  apiKey      String?
  endpoint    String?
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DataSource {
  id          String   @id @default(cuid())
  name        String   @unique // MOCK, B3, PROFITDLL, MT5
  type        String
  config      String   // JSON string with credentials/settings
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemMetrics {
  id          String   @id @default(cuid())
  metricName  String
  value       Float
  timestamp   DateTime @default(now())
  
  @@index([metricName])
  @@index([timestamp])
}

model SpreadOrder {
  id              String   @id @default(cuid())
  assetId1        String
  assetId2        String
  type1           String   // BUY, SELL
  type2           String   // BUY, SELL
  quantity1       Int
  quantity2       Int
  price1          Float
  price2          Float
  spreadValue     Float
  status          String   // PENDING, FILLED, CANCELLED, REJECTED
  isAutomated     Boolean  @default(false)
  automationTarget Float?
  automationCondition String? // greater_than, less_than, equal_to
  createdAt       DateTime @default(now())
  filledAt        DateTime?
  mt5OrderTicket1 Int?
  mt5OrderTicket2 Int?
  
  @@index([assetId1])
  @@index([assetId2])
  @@index([status])
  @@index([createdAt])
}

// Modelo para monitoramento de ações B3 (apenas monitoramento, sem envio de ordens)
model StockMonitoring {
  id                          String   @id @default(cuid())
  assetId                     String
  asset                       Asset    @relation(fields: [assetId], references: [id])
  
  // Dados fundamentais
  stockType                   String   // ON, PN
  composition                 Float    @default(1)
  payoutEstatuto              Float?
  dyMedia3Anos                Float?
  
  // Gatilhos de compra (indicadores para decisão)
  gatilhoROE                  Float?
  gatilhoVPA                  Float?
  gatilhoLPA                  Float?
  
  // Preços de referência (cálculos da plataforma)
  precoTeto                   Float?
  precoTetoReajustado         Float?
  
  // Metas de posição
  metaPapeis                  Int      @default(0)
  investimentoNecessarioParaMeta Float?
  
  // Dados financeiros da empresa (entrada manual)
  patrimonioLiquido           Float?
  lucroLiquido                Float?
  acoesEmitidas               BigInt?
  vpa                         Float?
  pVpa                        Float?
  lpa                         Float?
  precoLucro                  Float?
  roe                         Float?
  
  // Projeção de dividendos
  previsaoDividendoAnual      Float?
  yieldOnCost                 Float?
  
  // Dados de posição (vêm do MT5)
  precoAtual                  Float?
  quantidadeAdquirida         Int      @default(0)
  precoMedioCompra            Float?
  valorInvestido              Float?
  valorCarteira               Float?
  resultado                   Float    @default(0)
  participacaoCarteira        Float?
  
  // Status do monitoramento
  status                      String   @default("NEUTRO") // COMPRA, VENDA, NEUTRO, ATENCAO
  observacoes                 String?
  
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  
  dividendMaps                DividendMap[]
  alerts                      StockAlert[]
  
  @@index([assetId])
  @@index([status])
}

// Mapa mensal de dividendos por ação
model DividendMap {
  id          String   @id @default(cuid())
  stockId     String
  jan         Float    @default(0)
  fev         Float    @default(0)
  mar         Float    @default(0)
  abr         Float    @default(0)
  mai         Float    @default(0)
  jun         Float    @default(0)
  jul         Float    @default(0)
  ago         Float    @default(0)
  set         Float    @default(0)
  out         Float    @default(0)
  nov         Float    @default(0)
  dez         Float    @default(0)
  total       Float    @default(0)
  ano         Int
  
  stock       StockMonitoring @relation(fields: [stockId], references: [id])
  
  @@unique([stockId, ano])
  @@index([stockId])
}

// Alertas específicos para monitoramento de ações
model StockAlert {
  id          String   @id @default(cuid())
  stockId     String
  stock       StockMonitoring @relation(fields: [stockId], references: [id])
  
  type        String   // PRICE, DIVIDEND, STATUS, PORTFOLIO
  condition   String   // above, below, equals, changed_to
  value       Float?
  targetValue Float?
  message     String
  severity    String   // INFO, WARNING, CRITICAL
  isActive    Boolean  @default(true)
  isRead      Boolean  @default(false)
  triggeredAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([stockId])
  @@index([isActive])
  @@index([isRead])
  @@index([type])
}

// Relatórios de monitoramento de ações
model StockReport {
  id          String   @id @default(cuid())
  name        String
  type        String   // PORTFOLIO, PERFORMANCE, DIVIDENDS, STATUS

  startDate   DateTime
  endDate     DateTime

  // Dados do relatório (JSON)
  data        String   // JSON com dados do relatório

  generatedBy String   // Sistema ou usuário

  createdAt   DateTime @default(now())

  @@index([type])
  @@index([startDate])
  @@index([endDate])
}

// Cache de candles históricos do MT5 para o pipeline de ML
model HistoricalCandle {
  id        Int      @id @default(autoincrement())
  symbol    String
  timeframe String
  time      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, time])
  @@index([symbol, timeframe, time])
}

// ---------------------------------------------------------------------------
// Fase 2 / Item 1 — Fundação de dados de referência (Issuer + Instrument +
// IngestionRun). Modelos ADITIVOS: nenhum modelo existente foi alterado.
// Invariantes de ciclo de vida/intervalo são garantidos no repositório
// (unit of work), não por triggers SQL. Ver
// docs/architecture/phase-2-item-1-reference-data.md
// ---------------------------------------------------------------------------

// Ledger de execuções de ingestão de dados de referência.
// sourceKey é uma String imutável normalizada (sem relação com DataSource legado).
// completedAt de uma run SUCCEEDED é o knowledgeTime das linhas criadas por ela.
model IngestionRun {
  id          String    @id @default(cuid())
  sourceKey   String
  status      String // RUNNING, SUCCEEDED, FAILED
  startedAt   DateTime
  completedAt DateTime?
  summary     String? // JSON com resumo do lote

  issuers                   Issuer[]
  createdInstrumentVersions InstrumentVersion[] @relation("InstrumentVersionCreatedByRun")
  closedInstrumentVersions  InstrumentVersion[] @relation("InstrumentVersionClosedByRun")
  cvmFilings                CvmFiling[]
  cvmFacts                  CvmFact[]
  shareCapitalFacts         ShareCapitalFact[]
  versionedMarketBars       VersionedMarketBar[]
  datasetSnapshots          DatasetSnapshot[]
  featureValues             FeatureValue[]

  @@index([sourceKey, startedAt])
  @@index([status])
}

// Identidade estável e imutável de emissor, chaveada por cvmCode normalizado.
// Registro conflitante com identidade existente falha fechado (sem SCD-1 destrutivo).
// cnpj é opcional (múltiplos NULL aceitos) e único quando presente — 14 dígitos.
model Issuer {
  id             String  @id @default(cuid())
  cvmCode        String  @unique
  cnpj           String? @unique
  name           String
  createdByRunId String

  createdByRun       IngestionRun        @relation(fields: [createdByRunId], references: [id])
  instrumentVersions InstrumentVersion[]
  cvmFilings         CvmFiling[]
  cvmFacts           CvmFact[]
  shareCapitalFacts  ShareCapitalFact[]

  @@index([createdByRunId])
}

// Versão SCD-2 de instrumento com intervalo semiaberto [validFrom, validTo).
// validTo NULL = intervalo aberto (no máximo um por (symbol, exchange)).
// priceScalePow/quantityScalePow são EXPOENTES decimais: quantum = 10^scalePow
// (scalePow pode ser negativo). validFromBasis: SOURCE_EFFECTIVE | OBSERVED_AT.
model InstrumentVersion {
  id               String    @id @default(cuid())
  symbol           String
  exchange         String
  currency         String
  displayName      String
  assetClass       String
  status           String // ACTIVE, SUSPENDED, DELISTED
  priceScalePow    Int?
  quantityScalePow Int?
  lotSize          Int?
  validFrom        DateTime
  validTo          DateTime?
  validFromBasis   String // SOURCE_EFFECTIVE, OBSERVED_AT
  issuerId         String?
  createdByRunId   String
  closedByRunId    String?

  issuer       Issuer?       @relation(fields: [issuerId], references: [id])
  createdByRun IngestionRun  @relation("InstrumentVersionCreatedByRun", fields: [createdByRunId], references: [id])
  closedByRun  IngestionRun? @relation("InstrumentVersionClosedByRun", fields: [closedByRunId], references: [id])

  versionedMarketBars VersionedMarketBar[]

  @@unique([symbol, exchange, validFrom])
  @@index([symbol, exchange, validTo])
  @@index([issuerId])
  @@index([createdByRunId])
  @@index([closedByRunId])
}

// ---------------------------------------------------------------------------
// Fase 2 / Item 2 — CVM Filings e Fatos Point-in-Time (CvmFiling + CvmFact +
// ShareCapitalFact). Modelos ADITIVOS: nenhum modelo existente foi alterado.
// Append-only: nenhuma linha é jamais UPDATE/DELETE destrutivo. Invariantes
// de idempotência/cadeia de retificação/point-in-time são garantidos na
// PrismaCvmIngestionUnitOfWork (não por triggers SQL). Ver
// docs/architecture/phase-2-item-2-cvm-facts.md
// ---------------------------------------------------------------------------

// Documento regulatório CVM (DFP/ITR/FRE) de um Issuer já existente (o batch
// CVM nunca cria Issuer). publishedAt é o eixo de disponibilidade de mercado;
// o knowledgeTime da plataforma é sempre derivado via join com createdByRun
// (completedAt), nunca persistido aqui. cvmProtocol é globalmente único.
// versionNumber/isRestatement/supersedesFilingId formam a cadeia de
// retificação; nenhuma linha anterior é jamais atualizada ou apagada.
model CvmFiling {
  id                  String    @id @default(cuid())
  issuerId            String
  documentType        String // DFP, ITR, FRE
  cvmProtocol         String    @unique
  referenceDate       String // YYYY-MM-DD
  fiscalYear          Int
  fiscalQuarter       Int?
  filedAt             DateTime
  publishedAt         DateTime
  versionNumber       Int
  isRestatement       Boolean
  supersedesFilingId  String?   @unique
  sourceUrl           String
  rawSha256           String // 64 lowercase hex chars
  createdByRunId      String

  issuer            Issuer         @relation(fields: [issuerId], references: [id])
  createdByRun      IngestionRun   @relation(fields: [createdByRunId], references: [id])
  supersedesFiling  CvmFiling?     @relation("CvmFilingChain", fields: [supersedesFilingId], references: [id])
  supersededByFilings CvmFiling[]  @relation("CvmFilingChain")

  facts             CvmFact[]
  shareCapitalFacts ShareCapitalFact[]

  @@unique([issuerId, documentType, referenceDate, versionNumber])
  @@index([createdByRunId])
  @@index([publishedAt])
}

// Fato contábil exato extraído de um CvmFiling. valor real = valueRaw *
// 10^scalePow. INSTANT exige periodStart === periodEnd; DURATION exige
// periodStart <= periodEnd. Unicidade dentro do filing garantida em
// runtime (não pode ser um @@unique físico por causa de NULL em SQLite
// não seria o problema aqui — todos os campos são NOT NULL — o índice
// único abaixo garante a unicidade normativa).
model CvmFact {
  id             String   @id @default(cuid())
  filingId       String
  issuerId       String
  statementType  String // BPA, BPP, DRE, DFC_MD, DFC_MI, DVA, DMPL
  scope          String // CON, IND
  accountCode    String
  accountLabel   String
  periodStart    String // YYYY-MM-DD
  periodEnd      String // YYYY-MM-DD
  durationType   String // INSTANT, DURATION
  valueRaw       BigInt
  scalePow       Int
  originalScale  String
  currency       String
  quality        String
  createdByRunId String

  filing       CvmFiling    @relation(fields: [filingId], references: [id])
  issuer       Issuer       @relation(fields: [issuerId], references: [id])
  createdByRun IngestionRun @relation(fields: [createdByRunId], references: [id])

  @@unique([filingId, statementType, scope, accountCode, periodStart, periodEnd])
  @@index([issuerId, statementType, scope, accountCode, periodEnd])
  @@index([filingId])
  @@index([createdByRunId])
}

// Composição de capital social extraída de um CvmFiling. periodStart ===
// periodEnd sempre (conceito INSTANT). quantity é não-negativa, signed 64-bit.
model ShareCapitalFact {
  id             String   @id @default(cuid())
  filingId       String
  issuerId       String
  shareClass     String
  periodStart    String // YYYY-MM-DD
  periodEnd      String // YYYY-MM-DD
  quantity       BigInt
  quantityType   String // ISSUED, OUTSTANDING, TREASURY
  quality        String
  createdByRunId String

  filing       CvmFiling    @relation(fields: [filingId], references: [id])
  issuer       Issuer       @relation(fields: [issuerId], references: [id])
  createdByRun IngestionRun @relation(fields: [createdByRunId], references: [id])

  @@unique([filingId, shareClass, periodEnd, quantityType])
  @@index([issuerId, shareClass, quantityType, periodEnd])
  @@index([filingId])
  @@index([createdByRunId])
}

// ---------------------------------------------------------------------------
// Fase 2 / Item 3 — Fundação de MarketBar versionada e point-in-time
// (VersionedMarketBar). Modelo ADITIVO: nenhum modelo legado (MarketData,
// HistoricalCandle) foi alterado. Apenas relações aditivas foram adicionadas
// a IngestionRun e InstrumentVersion (sem colunas novas nessas tabelas).
// Append-only: nenhuma linha é jamais UPDATE/DELETE destrutivo. Invariantes
// de idempotência/cadeia de revisão/point-in-time são garantidas na
// PrismaMarketBarIngestionUnitOfWork (não por triggers SQL). Ver
// docs/architecture/phase-2-item-3-market-bar.md
// ---------------------------------------------------------------------------

// Barra de mercado (OHLCV) versionada por fonte/revisão, exata (sem float) e
// point-in-time. Valor real de preço = rawValue * 10^priceScalePow; valor
// real de volume = volumeRaw * 10^volumeScalePow. sourceKey é derivado da
// IngestionRun corrente (nunca enviado na submission). Cadeia de revisão:
// root tem revisionNumber=1 e supersedesBarId=null; cada revisão aponta
// para o predecessor via supersedesBarId (único) e revisionNumber =
// predecessor.revisionNumber + 1.
model VersionedMarketBar {
  id                  String   @id @default(cuid())
  instrumentVersionId String
  sourceKey           String
  sourceRecordKey     String
  timeframe           String
  openedAt            DateTime
  closedAt            DateTime
  sourceAvailableAt   DateTime
  openRaw             BigInt
  highRaw             BigInt
  lowRaw              BigInt
  closeRaw            BigInt
  priceScalePow       Int
  volumeRaw           BigInt
  volumeScalePow      Int
  volumeSemantics     String // TICKS, CONTRACTS, SHARES, NOTIONAL
  tradeCount          BigInt?
  priceBasis          String // TRADE, MID, BID, ASK
  quality             String // FINAL, PROVISIONAL, ESTIMATED, CORRECTED
  rawSha256           String // 64 lowercase hex chars
  revisionNumber      Int
  supersedesBarId     String?  @unique
  createdByRunId      String

  instrumentVersion InstrumentVersion    @relation(fields: [instrumentVersionId], references: [id])
  createdByRun      IngestionRun         @relation(fields: [createdByRunId], references: [id])
  supersedesBar     VersionedMarketBar?  @relation("MarketBarRevisionChain", fields: [supersedesBarId], references: [id])
  supersededByBars  VersionedMarketBar[] @relation("MarketBarRevisionChain")

  @@unique([instrumentVersionId, timeframe, sourceKey, openedAt, revisionNumber])
  @@unique([sourceKey, sourceRecordKey])
  @@index([instrumentVersionId, timeframe, sourceKey, openedAt])
  @@index([createdByRunId])
  @@index([sourceAvailableAt])
}

// ---------------------------------------------------------------------------
// Fase 2 / Item 5 — DatasetSnapshot e FeatureValue com knowledgeTime.
// Modelos ADITIVOS: nenhum modelo legado ou de itens anteriores foi
// alterado. Apenas relações aditivas foram adicionadas a IngestionRun
// (sem colunas novas nessa tabela). Somente leitura: nenhuma rota de
// escrita é exposta; ambos os modelos são append-only (deleções/updates
// via repositório são bloqueados por construção — os ports não expõem
// métodos de mutação). Ver docs/architecture/phase-2-item-5-dataset-feature.md
// ---------------------------------------------------------------------------

// Metadados point-in-time do estado do repositório de dados em um dado
// decisionTime/knowledgeTime. domains é um objeto JSON (persistido como
// TEXT) com contagens por domínio (referenceData/cvm/marketBars). Duas
// linhas com o mesmo decisionTime e knowledgeTime distintos não são
// conflitantes: representam estados diferentes de conhecimento ao longo
// do tempo. createdAt é o timestamp real de insert (sempre > knowledgeTime).
model DatasetSnapshot {
  id             String   @id @default(cuid())
  snapshotId     String
  asOf           DateTime
  knowledgeTime  DateTime
  decisionTime   DateTime
  domains        String // JSON: {referenceData:{issuers,instrumentVersions}, cvm:{filings,facts,shareCapitalFacts}, marketBars:{count}}
  createdByRunId String
  createdAt      DateTime @default(now())

  createdByRun IngestionRun @relation(fields: [createdByRunId], references: [id])

  @@index([decisionTime, knowledgeTime])
  @@index([createdByRunId])
}

// Valor de feature bruto, já calculado e aprovado em outro lugar — nunca
// scoring, ranking, sinal ou narrativa de agente. Somente os tipos
// STRING/BIGINT/DATE/ENUM são aceitos (FLOAT é estruturalmente
// impossível, tanto no schema Prisma quanto na validação Zod da camada
// de adaptador). Real value (quando BIGINT) = valueRaw interpretado como
// inteiro exato * 10^scalePow; scalePow é obrigatório apenas para BIGINT
// e limitado a [-18,18]. sourceKey é derivado da IngestionRun criadora,
// exatamente como em VersionedMarketBar (nunca enviado na submissão).
// Append-only: para "atualizar" um valor, insira nova entry com
// knowledgeTime posterior; o passado nunca é alterado.
model FeatureValue {
  id             String   @id @default(cuid())
  featureId      String
  subjectId      String
  featureType    String // STRING, BIGINT, DATE, ENUM
  valueRaw       String
  scalePow       Int?
  enumValue      String?
  label          String?
  sourceKey      String
  knowledgeTime  DateTime
  decisionTime   DateTime
  createdByRunId String
  createdAt      DateTime @default(now())

  createdByRun IngestionRun @relation(fields: [createdByRunId], references: [id])

  @@unique([featureId, decisionTime, knowledgeTime])
  @@index([decisionTime, knowledgeTime])
  @@index([subjectId, featureType, knowledgeTime])
  @@index([createdByRunId])
}

// ---------------------------------------------------------------------------
// Fase 2 / Item 6 — Reconciliação e paridade com legado (somente leitura).
// Modelos ADITIVOS: nenhum modelo legado ou de itens anteriores foi
// alterado. Estas três tabelas existem para eventual persistência de
// auditoria de planos/relatórios de reconciliação já computados; as rotas
// GET /api/v1/reconciliation/* deste item computam a comparação sob
// demanda (leitura pura de VersionedMarketBar/CvmFact/ShareCapitalFact
// contra HistoricalCandle/MarketData/StockMonitoring) e não escrevem
// nestas tabelas — nenhum endpoint de escrita é exposto neste item. Ver
// docs/architecture/phase-2-item-6-reconciliation.md
// ---------------------------------------------------------------------------

// Registro de um plano de reconciliação (parâmetros de uma consulta
// GET /api/v1/reconciliation/plan já resolvida). Reservado para uso
// futuro de auditoria; sem escrita neste item.
model ReconciliationPlan {
  id             String   @id @default(cuid())
  planId         String   @unique
  domain         String?
  subjectId      String?
  decisionTime   DateTime
  knowledgeTime  DateTime
  createdByRunId String?
  createdAt      DateTime @default(now())

  rows ReconciliationRow[]

  @@index([decisionTime, knowledgeTime])
  @@index([createdByRunId])
}

// Registro de um relatório de reconciliação agregado (parâmetros de uma
// consulta GET /api/v1/reconciliation/report já resolvida). Reservado
// para uso futuro de auditoria; sem escrita neste item.
model ReconciliationReport {
  id             String   @id @default(cuid())
  reportId       String   @unique
  domain         String?
  fromTime       DateTime
  toTime         DateTime
  overall        String // PARIDADE, PARIDADE_PARCIAL, SEM_PARIDADE
  computedAt     DateTime
  decisionTime   DateTime
  knowledgeTime  DateTime
  createdByRunId String?
  createdAt      DateTime @default(now())

  @@index([decisionTime, knowledgeTime])
  @@index([createdByRunId])
}

// Linha de comparação por domínio (cvm-facts, market-bars,
// stock-monitoring) de um ReconciliationPlan. Reservado para uso futuro
// de auditoria; sem escrita neste item.
model ReconciliationRow {
  id              String    @id @default(cuid())
  planId          String
  domain          String
  legacySource    String
  newSource       String
  legacyCount     BigInt
  newCount        BigInt
  sampleLegacyIds String // JSON array de strings
  sampleNewIds    String // JSON array de strings
  matchedSamples  Int
  mismatchSamples Int
  decidedAt       DateTime
  decisionTime    DateTime
  knowledgeTime   DateTime
  createdByRunId  String?
  createdAt       DateTime  @default(now())

  plan ReconciliationPlan @relation(fields: [planId], references: [id])

  @@unique([planId, domain])
  @@index([domain, decisionTime, knowledgeTime])
  @@index([createdByRunId])
}

// ---------------------------------------------------------------------------
// Fase 3 / Item 1 — runtime assíncrono e persistente de AgentRun. Modelo
// ADITIVO: nenhum modelo legado ou de itens anteriores foi alterado. O
// processamento deste item é simulado/determinístico (sem LLM real), sem
// ponte para ExecutionBroker/ordens reais. Ver
// docs/architecture/phase-3-item-1-agent-run.md
// ---------------------------------------------------------------------------
model AgentRun {
  id            String    @id @default(cuid())
  runId         String    @unique
  requestedBy   String
  kind          String // RESEARCH | PROPOSAL
  status        String // QUEUED | RUNNING | SUCCEEDED | FAILED | CANCELLED
  dag           String // JSON: DAG semântico { nodes: {id,type,role?,reads?,provides?}[]; edges: [string, string][] }
  inputJson     String // JSON do payload de entrada validado por Zod
  budgetJson    String // JSON: { maxSteps?, maxCost?, timeoutMs? }
  outputJson    String? // JSON do contrato de saída; só em SUCCEEDED
  errorJson     String? // JSON sanitizado; só em FAILED
  nodeStatesJson String? // JSON: Record<nodeId, { status, output? }> — observabilidade do DAG (Item 2)
  stepsUsed     Int       @default(0) // contador de nós executados (orçamento maxSteps, Item 2)
  costUsed      Int       @default(0) // custo estimado acumulado (orçamento maxCost, Item 2)
  decisionTime  DateTime
  knowledgeTime DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  finishedAt    DateTime?

  @@index([status, createdAt])
  @@index([requestedBy, createdAt])
  @@index([decisionTime, knowledgeTime])
  @@index([status, updatedAt])
}

// ---------------------------------------------------------------------------
// Fase 3 / Item 3 — ledger de auditoria do motor `RiskPolicy` (determinístico,
// sem LLM). ADITIVO: nenhum modelo legado ou de itens anteriores foi
// alterado. Não conecta a `ExecutionBroker`/ordens reais; toda avaliação é
// apenas persistida como decisão auditável. Ver
// docs/architecture/phase-3-item-3-risk-policy.md
// ---------------------------------------------------------------------------
model RiskDecision {
  id                 String   @id @default(cuid())
  decisionId         String   @unique
  runId              String
  requestedBy        String
  instrumentId       String
  direction          String // BUY | SELL | HOLD
  outcome            String // APPROVED | REJECTED
  reasonsJson        String // JSON: string[] de códigos de regra
  policyVersion      String
  proposalJson       String // snapshot do TradeProposal avaliado
  contextJson        String // snapshot do RiskEvaluationContext aplicado
  policySnapshotJson String? // snapshot das regras/limites aplicados
  decisionTime       DateTime
  knowledgeTime      DateTime
  evaluatedAt        DateTime @default(now())

  @@index([runId, evaluatedAt])
  @@index([outcome, evaluatedAt])
  @@index([instrumentId, evaluatedAt])
}

// ---------------------------------------------------------------------------
// Fase 3 / Item 4 — aprovação humana + `idempotency key` (gate de
// execução). ADITIVO: nenhum modelo legado ou de itens anteriores foi
// alterado. `OrderIntent` é apenas intenção auditável, nunca ordem
// executada — `ExecutionBroker` continua desabilitado. Ver
// docs/architecture/phase-3-item-4-order-intent-approval.md
// ---------------------------------------------------------------------------
model HumanApprovalReceipt {
  approvalId      String   @id @default(cuid())
  decisionId      String
  approvedBy      String
  approvedAt      DateTime
  policyVersion   String
  decisionOutcome String // APPROVED
  createdAt       DateTime @default(now())

  @@index([decisionId])
  @@index([approvedBy, createdAt])
}

model OrderIntent {
  intentId       String    @id @default(cuid())
  decisionId     String
  approvalId     String
  idempotencyKey String    @unique
  requestedBy    String
  approvedBy     String
  instrumentId   String
  direction      String // BUY | SELL
  quantity       Int
  status         String // CREATED | CANCELLED
  policyVersion  String
  decisionTime   DateTime
  knowledgeTime  DateTime
  createdAt      DateTime  @default(now())
  cancelledAt    DateTime?

  @@index([decisionId])
  @@index([approvalId])
  @@index([requestedBy, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Fase 5 — Pesquisa, backtest e ML (point-in-time, sem lookahead). ADITIVO:
// nenhum modelo anterior foi alterado. Ver
// docs/architecture/phase-5-research-backtest-ml.md
// ---------------------------------------------------------------------------
model ResearchRun {
  runId          String    @id @default(cuid())
  name           String
  hypothesis     String // texto livre / proveniência (pode vir de LLM, mas NÃO decide trade)
  datasetId      String
  windowStart    DateTime
  windowEnd      DateTime
  paramsJson     String // hiperparâmetros (snapshot)
  createdBy      String
  createdAt      DateTime  @default(now())
  modelVersionId String?

  @@index([datasetId, createdAt])
  @@index([createdBy, createdAt])
}

model ModelVersion {
  modelVersion         String    @id @default(cuid())
  kind                 String // 'ML' | 'RULE'
  label                String
  asOf                 DateTime
  hyperparametersJson  String
  trainingEvidenceJson String? // métricas de fit/validation/test; obrigatório quando kind='ML'
  invalidatedAt        DateTime?
  invalidationReason   String?
  createdAt            DateTime  @default(now())

  @@index([kind, asOf])
}

model Signal {
  signalId      String   @id @default(cuid())
  modelVersionId String
  instrumentId  String
  barTime       DateTime // instante do sinal (ex.: close[t])
  direction     String // BUY | SELL | HOLD
  score         Float?
  knowledgeTime DateTime // point-in-time: dados usados até aqui
  createdAt     DateTime @default(now())

  @@index([modelVersionId, barTime])
  @@index([instrumentId, barTime])
}

model BacktestRun {
  backtestId     String   @id @default(cuid())
  researchRunId  String
  modelVersionId String
  instrumentId   String
  entryRule      String // 'open_next_bar' (único permitido: t+1)
  costsJson      String // corretagem, emolumentos, spreadBps, slippageBps, lote
  windowStart    DateTime
  windowEnd      DateTime
  metricsJson    String // Sharpe por período, retorno, drawdown, n_trades, etc.
  embargoDays    Int // purge/embargo entre treino e teste
  createdAt      DateTime @default(now())

  @@index([researchRunId])
  @@index([modelVersionId, instrumentId])
}

// ---------------------------------------------------------------------------
// Fase 6 — Consolidação (repository governado, replay, auditoria). ADITIVO:
// nenhum modelo anterior foi alterado, inclusive `SpreadOrder` (legado, acima).
// Ver docs/architecture/phase-6-consolidation.md
// ---------------------------------------------------------------------------
model OptionPosition {
  id            String   @id @default(cuid())
  instrumentId  String
  kind          String // CALL | PUT
  strike        Int // em centavos
  expiration    DateTime
  side          String // LONG | SHORT
  quantity      Int
  source        String // MT5 | MANUAL | REPLAY
  knowledgeTime DateTime
  createdAt     DateTime @default(now())

  @@index([instrumentId, expiration])
}

model SpreadOrderAudit {
  auditId       String   @id @default(cuid())
  orderId       String
  action        String // CREATE | CANCEL
  requestedBy   String
  payloadJson   String
  policyVersion String
  decisionTime  DateTime
  knowledgeTime DateTime
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([action, createdAt])
}
