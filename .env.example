# WR Trade Pro environment template
#
# Copy this file to .env for local use and fill values locally.
# Never commit real credentials, passwords, tokens, or API keys.

DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Autenticação local (Fase 0, Item 9) — SERVER-SIDE ONLY, sem NEXT_PUBLIC_.
# NUNCA usar credenciais do MT5 aqui. Sem estas 3 variáveis o login é
# recusado (fail-closed) e todas as rotas ficam bloqueadas.
#
# Gerar WR_AUTH_PASSWORD_HASH e WR_AUTH_SESSION_SECRET com:
#   node scripts/auth/generate-password-hash.mjs
# Instruções completas: docs/AUTH_SETUP.md
# ---------------------------------------------------------------------------
WR_AUTH_USERNAME=""
# Formato: scrypt$N$r$p$<salt hex>$<hash hex> — nunca colocar a senha em claro
WR_AUTH_PASSWORD_HASH=""
# Mínimo 32 caracteres; assina o cookie de sessão HttpOnly
WR_AUTH_SESSION_SECRET=""
# Opcional: duração da sessão em horas (padrão 12)
# WR_AUTH_SESSION_TTL_HOURS="12"
# Opcional: "true" apenas se servir via HTTPS (padrão false — app local http://127.0.0.1)
# WR_AUTH_COOKIE_SECURE="false"

# LLM providers — SERVER-SIDE ONLY.
# Nunca usar o prefixo NEXT_PUBLIC_ para segredos: ele embute o valor no
# bundle JavaScript do frontend. Estas variáveis são lidas apenas pelo
# backend (src/lib/server/llm-config.ts). Bootstrap/fallback: a UI de
# Configurações de IA (Settings > Provedores de LLM) permite salvar chaves e
# defaults sem editar o .env — quando salva pela UI, ela sobrepõe estes
# valores (ver WR_LLM_CONFIG_ENCRYPTION_KEY abaixo).
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4.1-mini"
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""
GROQ_API_KEY=""
MANUS_API_KEY=""

# OpenRouter — roteador de múltiplos modelos, incluindo opções gratuitas.
# OPENROUTER_DEFAULT_MODEL pode ser "openrouter/free" ou qualquer outro model
# id permitido pelo schema (ver LLM_MODEL_ID_PATTERN em src/types/llm.ts).
OPENROUTER_API_KEY=""
OPENROUTER_DEFAULT_MODEL="openrouter/free"
# Opcionais, sem segredo — enviados como headers para o OpenRouter.
# OPENROUTER_APP_TITLE="WR Trading Pro"
# OPENROUTER_HTTP_REFERER=""

# Anthropic Claude — API nativa Messages (x-api-key + anthropic-version).
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-3-5-haiku-latest"

# LM Studio — servidor local OpenAI-compatible. LM_STUDIO_API_KEY é opcional:
# se vazio, nenhum header Authorization é enviado; se preenchido, é enviado
# como Bearer server-side. Mesma allowlist local do Ollama (proteção SSRF).
LM_STUDIO_ENDPOINT="http://127.0.0.1:1234/v1"
LM_STUDIO_DEFAULT_MODEL=""
LM_STUDIO_API_KEY=""

# Endpoint local do Ollama. Allowlist estrita: apenas http em
# localhost / 127.0.0.1 / ::1 — valores fora disso são ignorados
# com fallback para http://127.0.0.1:11434 (proteção contra SSRF).
OLLAMA_ENDPOINT="http://localhost:11434"

# ---------------------------------------------------------------------------
# Chave de criptografia da configuração de LLM salva pela UI (Settings) —
# SERVER-SIDE ONLY, mínimo 32 caracteres. Protege em repouso (AES-256-GCM,
# nonce/tag por registro) as chaves de API salvas via
# POST /api/llm/config. Sem esta variável, a rota de salvar/limpar falha
# fechado (503) — a configuração via .env acima continua funcionando
# normalmente, só a persistência pela UI fica desabilitada.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
WR_LLM_CONFIG_ENCRYPTION_KEY=""

# B3 / market data
B3_API_KEY=""
B3_API_SECRET=""

# ProfitDLL / Nelogica
PROFITDLL_ACCESS_KEY=""
PROFITDLL_USERNAME=""
PROFITDLL_PASSWORD=""
PROFITDLL_DLL_PATH=""
PROFITDLL_PYTHON_SERVER_URL="ws://localhost:8765"

# MetaTrader 5
MT5_LOGIN=""
MT5_PASSWORD=""
MT5_SERVER=""

# ---------------------------------------------------------------------------
# MT5 MCP nativo (build 6060+) — SERVER-SIDE ONLY, sem NEXT_PUBLIC_.
#
# O terminal MT5 (Windows) expõe um servidor MCP embutido via Streamable
# HTTP quando "Ativar servidor interno" está ligado em Tools > Options > MCP.
# Ele lê a conta JÁ autenticada na GUI do terminal — a WR não envia login/
# senha para ele. Usado para dados read-only (conta, posições, ticks, book,
# candles, histórico, símbolos). Envio/modificação/cancelamento de ordem NÃO
# está habilitado — o trilho de trade é fail-closed do lado TS
# (Mt5TradingUnavailableError; eligibleForExecution=false); nenhuma ordem é
# enviada.
#
# Como a WR roda nativamente no Windows (Electron + Next em 127.0.0.1:3001),
# o endpoint correto é o loopback direto do próprio Windows — NÃO o proxy
# WSL usado pelo Hermes (esse serve só para acesso a partir do WSL).
#
# MT5_MCP_API_KEY: gere em MT5 > Tools > Options > MCP > Generate (botão
# "Gerar"/"Generate"). É um token PRÓPRIO da WR — não reaproveite o token de
# nenhuma outra integração (ex.: Hermes). Sem esta variável, os endpoints
# /api/mt5/mcp/* falham fechado (503) e a UI mostra "MCP não configurado",
# nunca finge estar conectada.
# ---------------------------------------------------------------------------
MT5_MCP_ENDPOINT="http://127.0.0.1:22346/mcp"
MT5_MCP_API_KEY=""
# Intervalo do polling de ticks/book em ms (padrão 1500 — o MCP nativo é
# request/response, não push; não reduza demais para não sobrecarregar o
# terminal).
# MT5_MCP_POLL_INTERVAL_MS="1500"

# Modelo padrão do Ollama local (nós AGENT do runtime e chat LLM)
OLLAMA_DEFAULT_MODEL="llama3.2:3b"

# ---------------------------------------------------------------------------
# MCP Piloto (Hermes) — servidor HTTP+Bearer em src/mcp/pilot/. Fail-closed:
# sem WR_MCP_HTTP_TOKEN e WR_SERVICE_TOKEN (ambos >= 32 chars) o processo
# `npm run mcp:pilot` não sobe (ver `resolvePilotConfig` em
# src/mcp/pilot/config.ts). Setup completo: docs/MCP_PILOT.md.
# Gerar tokens com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
WR_MCP_HTTP_TOKEN=troque-por-token-de-32+chars
# 127.0.0.1 (padrão) para uso só local; para expor ao WSL/Hermes, usar o IP
# do vswitch WSL (ex. 172.28.64.1) — ver docs/MCP_PILOT.md para a regra de
# firewall que restringe a porta a esse range.
WR_MCP_HTTP_HOST=127.0.0.1
WR_MCP_HTTP_PORT=8790
# Token Bearer usado pelo mcp-pilot para chamar as API routes do Next
# (middleware valida este mesmo valor do lado do servidor Next.js).
WR_SERVICE_TOKEN=troque-por-token-de-32+chars
# Opcionais — defaults já usados pelo mcp-pilot se omitidos:
# WR_MCP_NEXT_BASE_URL="http://127.0.0.1:3001"
# WR_MCP_SPREAD_API_URL="http://127.0.0.1:5000"
# WR_MCP_VOLATILITY_API_URL="http://127.0.0.1:5555"

# Trilho de trade governado (tools `trade.*`, as 4 únicas `privilege: gated`
# do catálogo) — ver src/application/mcp-trade/service.ts.
WR_MCP_TRADE_ALLOWLIST=PETR4,VALE3,ITUB4,BBDC4,ABEV3,WEGE3
WR_MCP_TRADE_MAX_NOTIONAL=50000
# WR_MCP_TRADE_MAX_CONCENTRATION_PCT="20"
WR_MCP_TRADE_MAX_PROPOSALS_PER_HOUR=10

# Kill switch (fail-closed) — permanece "false"; o trilho de trade é
# fail-closed do lado TS (ver src/application/mcp-trade/service.ts e
# Mt5TradingUnavailableError) — nenhuma ordem é enviada independentemente
# deste valor.
WR_TRADING_ENABLED=false
# APOSENTADA em 2026-08-12: WR_TRADING_DEMO_ONLY não existe mais. A guarda de
# conta DEMO vivia em python/mt5_bridge.py, removido em 2026-08-02; nunca foi
# reimplantada no caminho MCP nativo, e a variável seguia no .env declarando uma
# proteção inexistente. O que de fato limita execução hoje: kill switch
# WR_TRADING_ENABLED, aprovação humana com código de 6 dígitos, limite de
# notional, teto de concentração, rate limit e assertTradingEligible()
# (AutoTrading do terminal). NENHUM deles distingue conta demo de conta real.

# --- ML Engine (servico python/ml_api.py) ---
# Porta local do motor de ML (loopback-only)
WR_ML_API_PORT=5560
# URL usada pelo Next para falar com o motor
WR_ML_API_URL=http://127.0.0.1:5560
