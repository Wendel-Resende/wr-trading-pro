# WR Trade Pro environment template
#
# Copy this file to .env for local use and fill values locally.
# Never commit real credentials, passwords, tokens, or API keys.

DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Autenticação local (Fase 0, Item 9) — SERVER-SIDE ONLY, sem NEXT_PUBLIC_.
# NUNCA usar credenciais do MT5 aqui. Sem estas 3 variáveis o login é
# recusado (fail-closed) e todas as rotas ficam bloqueadas.
#
# Gerar WR_AUTH_PASSWORD_HASH e WR_AUTH_SESSION_SECRET com:
#   node scripts/auth/generate-password-hash.mjs
# Instruções completas: docs/AUTH_SETUP.md
# ---------------------------------------------------------------------------
WR_AUTH_USERNAME=""
# Formato: scrypt$N$r$p$<salt hex>$<hash hex> — nunca colocar a senha em claro
WR_AUTH_PASSWORD_HASH=""
# Mínimo 32 caracteres; assina o cookie de sessão HttpOnly
WR_AUTH_SESSION_SECRET=""
# Opcional: duração da sessão em horas (padrão 12)
# WR_AUTH_SESSION_TTL_HOURS="12"
# Opcional: "true" apenas se servir via HTTPS (padrão false — app local http://127.0.0.1)
# WR_AUTH_COOKIE_SECURE="false"

# ---------------------------------------------------------------------------
# Token WS efêmero do MT5 Bridge (Fase 0, Item 10) — SERVER-SIDE ONLY.
# Mínimo 32 caracteres. O MESMO valor precisa estar visível para o servidor
# Next e para python/mt5_bridge.py (em dev, exporte nos dois terminais ou use
# este .env + env do bridge). No Electron empacotado o secret é gerado
# automaticamente por processo — esta variável é só para dev externo.
# Sem secret o bridge rejeita todas as conexões (fail-closed).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Instruções completas: docs/WS_AUTH.md
# ---------------------------------------------------------------------------
WR_WS_TOKEN_SECRET=""
# Opcional: TTL do token em segundos (padrão 30, teto 60)
# WR_WS_TOKEN_TTL_SECONDS="30"

# LLM providers — SERVER-SIDE ONLY.
# Nunca usar o prefixo NEXT_PUBLIC_ para segredos: ele embute o valor no
# bundle JavaScript do frontend. Estas variáveis são lidas apenas pelo
# backend (src/lib/server/llm-config.ts).
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""
GROQ_API_KEY=""
MANUS_API_KEY=""

# Endpoint local do Ollama. Allowlist estrita: apenas http em
# localhost / 127.0.0.1 / ::1 — valores fora disso são ignorados
# com fallback para http://127.0.0.1:11434 (proteção contra SSRF).
OLLAMA_ENDPOINT="http://localhost:11434"

# B3 / market data
B3_API_KEY=""
B3_API_SECRET=""

# ProfitDLL / Nelogica
PROFITDLL_ACCESS_KEY=""
PROFITDLL_USERNAME=""
PROFITDLL_PASSWORD=""
PROFITDLL_DLL_PATH=""
PROFITDLL_PYTHON_SERVER_URL="ws://localhost:8765"

# MetaTrader 5
MT5_LOGIN=""
MT5_PASSWORD=""
MT5_SERVER=""

# Modelo padrão do Ollama local (nós AGENT do runtime e chat LLM)
OLLAMA_DEFAULT_MODEL="llama3.2:3b"

# ---------------------------------------------------------------------------
# MCP Piloto (Hermes) — servidor HTTP+Bearer em src/mcp/pilot/. Fail-closed:
# sem WR_MCP_HTTP_TOKEN e WR_SERVICE_TOKEN (ambos >= 32 chars) o processo
# `npm run mcp:pilot` não sobe (ver `resolvePilotConfig` em
# src/mcp/pilot/config.ts). Setup completo: docs/MCP_PILOT.md.
# Gerar tokens com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
WR_MCP_HTTP_TOKEN=troque-por-token-de-32+chars
# 127.0.0.1 (padrão) para uso só local; para expor ao WSL/Hermes, usar o IP
# do vswitch WSL (ex. 172.28.64.1) — ver docs/MCP_PILOT.md para a regra de
# firewall que restringe a porta a esse range.
WR_MCP_HTTP_HOST=127.0.0.1
WR_MCP_HTTP_PORT=8790
# Token Bearer usado pelo mcp-pilot para chamar as API routes do Next
# (middleware valida este mesmo valor do lado do servidor Next.js).
WR_SERVICE_TOKEN=troque-por-token-de-32+chars
# Opcionais — defaults já usados pelo mcp-pilot se omitidos:
# WR_MCP_NEXT_BASE_URL="http://127.0.0.1:3001"
# WR_MCP_SPREAD_API_URL="http://127.0.0.1:5000"
# WR_MCP_VOLATILITY_API_URL="http://127.0.0.1:5555"
# WR_MCP_BRIDGE_URL="ws://127.0.0.1:8766"

# Trilho de trade governado (tools `trade.*`, as 4 únicas `privilege: gated`
# do catálogo) — ver src/application/mcp-trade/service.ts.
WR_MCP_TRADE_ALLOWLIST=PETR4,VALE3,ITUB4,BBDC4,ABEV3,WEGE3
WR_MCP_TRADE_MAX_NOTIONAL=50000
# WR_MCP_TRADE_MAX_CONCENTRATION_PCT="20"
WR_MCP_TRADE_MAX_PROPOSALS_PER_HOUR=10

# Kill switch (fail-closed, lido tanto pelo OrderIntentService quanto pelo
# guard em python/mt5_bridge.py) — permanece "false" até o fim da etapa 1
# do rollout do MCP Piloto (ver docs/MCP_PILOT.md).
WR_TRADING_ENABLED=false
# Guarda DEMO do lado Python (python/mt5_bridge.py): com "true" (padrão),
# ordens só são enviadas se a conta MT5 logada for DEMO.
WR_TRADING_DEMO_ONLY=true

# --- ML Engine (servico python/ml_api.py) ---
# Porta local do motor de ML (loopback-only)
WR_ML_API_PORT=5560
# URL usada pelo Next para falar com o motor
WR_ML_API_URL=http://127.0.0.1:5560
