{
  "name": "wr-trade-pro",
  "version": "0.1.0",
  "private": true,
  "description": "WR Trading Pro - Platform for trading with MT5 integration",
  "author": "WR Trading",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "smoke:auth": "node scripts/auth/auth-smoke-test.mts",
    "smoke:ws-token": "node scripts/auth/ws-token-smoke-test.mts",
    "smoke:electron-hardening": "node scripts/auth/electron-hardening-smoke-test.mts",
    "smoke:domain-contracts": "tsc -p scripts/domain/tsconfig.json && node scripts/domain/domain-contracts-smoke-test.mjs",
    "test:contracts:ts": "tsc -p scripts/contracts/tsconfig.json && node scripts/contracts/contracts-cross-language-test.mts",
    "test:contracts:py": "python -m unittest python/tests/test_contracts_v1.py -v",
    "test:contracts": "npm run test:contracts:ts && npm run test:contracts:py",
    "test:workflow": "node scripts/workflow/run-workflow-test.cjs",
    "test:ws-token:py": "python python/tests/test_ws_token.py",
    "postinstall": "prisma generate",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "electron:build:win": "electron-builder --win",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:linux": "electron-builder --linux",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:package": "npm run build && npm run electron:compile && npm run mcp:pilot:compile && electron-builder",
    "test:mt5-adapters": "node scripts/mt5/run-mt5-tests.cjs",
    "test:reference-data": "node scripts/reference-data/run-reference-data-tests.cjs",
    "test:cvm-facts": "node scripts/cvm-facts/run-cvm-facts-tests.cjs",
    "test:market-bar": "node scripts/market-bar/run-market-bar-tests.cjs",
    "test:read-models-v1": "node scripts/read-models-v1/run-read-models-v1-tests.cjs",
    "test:dataset-feature": "node scripts/dataset-feature/run-dataset-feature-tests.cjs",
    "test:reconciliation": "node scripts/reconciliation/run-reconciliation-tests.cjs",
    "test:agent-run": "node scripts/agent-run/run-agent-run-tests.cjs",
    "test:risk-policy": "node scripts/risk-policy/run-risk-policy-tests.cjs",
    "test:order-intent": "node scripts/order-intent/run-order-intent-tests.cjs",
    "test:mcp": "node scripts/mcp/run-mcp-tests.cjs",
    "test:research-run": "node scripts/research-run/run-research-run-tests.cjs",
    "test:model-version": "node scripts/model-version/run-model-version-tests.cjs",
    "test:signal": "node scripts/signal/run-signal-tests.cjs",
    "test:b3-session": "node scripts/b3-session/run-b3-session-tests.cjs",
    "test:backtest-run": "node scripts/backtest-run/run-backtest-run-tests.cjs",
    "test:option-position": "node scripts/option-position/run-option-position-tests.cjs",
    "test:ml-hybrid": "node scripts/ml-hybrid/run-ml-hybrid-tests.cjs",
    "test:ml-unified-reads": "node scripts/ml-unified-reads/run-ml-unified-reads-tests.cjs",
    "test:ml-training-run": "node scripts/ml-training-run/run-ml-training-run-tests.cjs",
    "mcp:start": "tsc -p scripts/mcp/tsconfig.json && node scripts/mcp/.dist/src/mcp/index.js",
    "mcp:pilot:compile": "tsc -p scripts/mcp-pilot/tsconfig.json",
    "mcp:pilot": "npm run mcp:pilot:compile && node scripts/mcp-pilot/dist/src/mcp/pilot/index.js",
    "test:mcp-pilot": "node scripts/mcp-pilot/run-mcp-pilot-tests.cjs",
    "test:b3-ticker": "node scripts/b3-ticker/run-b3-ticker-tests.cjs",
    "test:cvm-fundamentals": "node scripts/cvm-fundamentals/run-cvm-fundamentals-tests.cjs",
    "test:directional-classifier": "node scripts/directional/run-directional-tests.cjs",
    "test:directional:py": "python python/tests/test_directional_classifier.py && python python/tests/test_directional_api.py"
  },
  "build": {
    "appId": "com.wrtrade.pro",
    "productName": "WR Trade Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**/*",
      ".next/**/*",
      "agents/**/*",
      "python/**/*",
      "scripts/mcp-pilot/dist/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "forceCodeSigning": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.1.0",
    "@tanstack/react-query": "^5.62.7",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^0.468.0",
    "next": "15.5.20",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "22.19.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "postcss": "^8",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wait-on": "^9.0.5"
  }
}
