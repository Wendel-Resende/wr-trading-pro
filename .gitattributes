# Canonical line endings prevent Windows/WSL diff noise.
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.prisma text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.dll binary
*.exe binary
*.pdf binary
*.xlsx binary
*.png binary
*.jpg binary
*.ico binary
