{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": "dist",
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  "include": [
    "mcp-pilot-test.ts",
    "../../src/mcp/**/*.ts",
    "../../src/application/**/*.ts",
    "../../src/adapters/prisma/**/*.ts",
    "../../src/domain/v1/**/*.ts",
    "../../src/app/api/v1/_shared/http.ts",
    "../../src/services/mlModels.ts",
    "../../src/services/backtesting.ts",
    "../../src/services/historicalDataService.ts",
    "../../src/lib/prisma.ts",
    "../../src/services/mt5Service.ts"
  ]
}
