{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": ".dist",
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "ml-unified-reads-test.ts",
    "../../src/adapters/prisma/**/*.ts",
    "../../src/domain/v1/**/*.ts",
    "../../src/application/**/*.ts",
    "../../src/app/api/v1/_shared/**/*.ts",
    "../../src/app/api/v1/ml/cost-profiles/**/*.ts",
    "../../src/app/api/v1/research-runs/**/*.ts",
    "../../src/app/api/v1/agent-runs/_requested-by.ts",
    "../../src/lib/**/*.ts"
  ]
}
